{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/build/assets/(.*)",
      "dest": "/build/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/build/(.*)",
      "dest": "/build/$1",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(favicon.*|apple-touch-icon.*|og-.*|robots.txt|ads.txt|sitemap.xml)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_LOCALE": "pt_BR",
    "APP_FALLBACK_LOCALE": "pt_BR",
    "APP_CONFIG_CACHE": "/tmp/storage/framework/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/storage/framework/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/framework/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/storage/framework/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/storage/framework/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}